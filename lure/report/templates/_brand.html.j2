{# Brand line for the page header: the avatar (from _avatar.html.j2, made by
   scripts/make_brand.py), the wordmark, then the page kind. #}
{% macro brand(kind) %}
<p class="kicker brand">
  {% include "_avatar.html.j2" %}
  <span class="wordmark">LURE</span><span class="sep" aria-hidden="true"></span><span>{{ kind }}</span>
</p>
{% endmacro %}
