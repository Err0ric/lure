<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lure report: {{ model }}</title>
<style>
:root {
  color-scheme: light;
  --page: #eef1f5;
  --sheet: #fbfcfd;
  --ink: #18202e;
  --ink-2: #4a5568;
  --muted: #646d7a;
  --rule: #d5dbe3;
  --rule-strong: #a9b3c1;
  --code-bg: #f1f4f8;
  --pass: #0ca30c;
  --partial: #fab219;
  --review: #ec835a;
  --fail: #d03b3b;
  --other: #898781;
  /* ASR, sequential blue: 0 recedes toward the sheet, 8 is every run failed. */
  --asr-0: #cde2fb; --asr-1: #b7d3f6; --asr-2: #86b6ef; --asr-3: #5598e7;
  --asr-4: #3987e5; --asr-5: #2a78d6; --asr-6: #1c5cab; --asr-7: #104281; --asr-8: #0d366b;
  --asr-ink-low: #18202e; --asr-ink-high: #ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0f141c; --sheet: #161c26; --ink: #e8ecf2; --ink-2: #b4bcc8; --muted: #8e97a5;
    --rule: #2a3341; --rule-strong: #465162; --code-bg: #1d2430;
    --asr-0: #0d366b; --asr-1: #104281; --asr-2: #184f95; --asr-3: #1c5cab;
    --asr-4: #2a78d6; --asr-5: #3987e5; --asr-6: #6da7ec; --asr-7: #9ec5f4; --asr-8: #cde2fb;
    --asr-ink-low: #ffffff; --asr-ink-high: #18202e;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0f141c; --sheet: #161c26; --ink: #e8ecf2; --ink-2: #b4bcc8; --muted: #8e97a5;
  --rule: #2a3341; --rule-strong: #465162; --code-bg: #1d2430;
  --asr-0: #0d366b; --asr-1: #104281; --asr-2: #184f95; --asr-3: #1c5cab;
  --asr-4: #2a78d6; --asr-5: #3987e5; --asr-6: #6da7ec; --asr-7: #9ec5f4; --asr-8: #cde2fb;
  --asr-ink-low: #ffffff; --asr-ink-high: #18202e;
}

* { box-sizing: border-box; }
html { background: var(--page); }
body {
  margin: 0; padding: 2.5rem 1rem 4rem;
  background: var(--page); color: var(--ink);
  font: 1rem/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-text-size-adjust: 100%;
}
.sheet {
  max-width: 64rem; margin: 0 auto; padding: 3rem clamp(1rem, 5vw, 3.75rem) 3.5rem;
  background: var(--sheet); border: 1px solid var(--rule); border-radius: 6px;
}
h1, h2, h3 {
  font-family: Charter, "Bitstream Charter", "Sitka Text", "Iowan Old Style", Cambria, Georgia, serif;
  font-weight: 500; letter-spacing: -0.005em; color: var(--ink);
}
h1 { font-size: clamp(1.9rem, 4.2vw, 2.75rem); line-height: 1.15; margin: 0.35rem 0 1.75rem; max-width: 26ch; }
h2 { font-size: 1.625rem; line-height: 1.25; margin: 3.25rem 0 0.5rem; }
h3 { font-size: 1.2rem; line-height: 1.3; margin: 0; }
p, li { max-width: 70ch; }
.lede { color: var(--ink-2); margin: 0 0 1.25rem; }
.kicker { color: var(--ink-2); margin: 0; }
a { color: inherit; }
code, pre, .mono { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.875rem; }

/* Run facts: one ruled strip, not cards. */
.facts {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1rem;
  margin: 0; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--rule);
}
.facts div { padding: 0.75rem 0 0.85rem; }
.facts div:nth-child(n+5) { border-top: 1px solid var(--rule); }
.facts dt { color: var(--ink-2); font-size: 0.875rem; }
.facts dd { margin: 0.15rem 0 0; font-size: 1.125rem; overflow-wrap: break-word; }
.facts dd small { display: block; color: var(--muted); font-size: 0.8125rem; }

.summary { padding-left: 1.25rem; margin: 0.75rem 0 0; }
.summary li { margin: 0 0 0.7rem; padding-left: 0.25rem; font-size: 1.0625rem; }

/* Tables */
.scroll { overflow-x: auto; margin-top: 1rem; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
caption { text-align: left; color: var(--ink-2); padding-bottom: 0.6rem; caption-side: top; max-width: 70ch; }
th, td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--rule); text-align: right; vertical-align: top; }
th:first-child, td:first-child { text-align: left; padding-left: 0; }
thead th { font-weight: 600; font-size: 0.875rem; color: var(--ink-2); border-bottom: 1px solid var(--rule-strong); white-space: nowrap; }
td.zero { color: var(--muted); }
.tech-id { display: block; font-size: 0.8125rem; color: var(--ink-2); }
.asr { min-width: 4.5rem; font-weight: 600; }
.asr-na, .asr-zero { background: transparent; color: var(--muted); font-weight: 400; }
{% for i in range(1, 9) %}
.asr-{{ i }} { background: var(--asr-{{ i }}); color: {{ "var(--asr-ink-low)" if i < 4 else "var(--asr-ink-high)" }}; }
{% endfor %}
.low { display: block; font-size: 0.75rem; font-weight: 400; opacity: 0.85; white-space: nowrap; }
.callout { margin: 1.75rem 0 0; padding: 0.9rem 0 0.4rem 1.1rem; border-left: 3px solid var(--partial); }
.callout h3 { font-size: 1.125rem; }
.callout p { margin: 0.4rem 0 0.6rem; }
.callout td.policy { text-align: left; max-width: 34rem; font-size: 0.875rem; }
.callout td.policy .shared { color: var(--muted); }
.callout mark.diff { background: color-mix(in srgb, var(--partial) 32%, transparent); color: var(--ink); font-weight: 600; padding: 0 0.15em; border-radius: 2px; }
.callout tr.did-row td { text-align: left; padding-left: 0; font-size: 0.875rem; }
.callout tbody.version tr:first-child th, .callout tbody.version tr:first-child td { border-bottom: 0; }
.note { color: var(--ink-2); font-size: 0.875rem; margin: 0.35rem 0 0; }
.legend { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.85rem; color: var(--ink-2); font-size: 0.875rem; flex-wrap: wrap; }
.ramp { display: inline-flex; border-radius: 3px; overflow: hidden; border: 1px solid var(--rule); }
.ramp span { width: 1.4rem; height: 0.8rem; }

/* Category table: category row, then its attacks. */
tbody.category th[scope="rowgroup"] { font-weight: 600; text-align: left; padding-left: 0; }
tbody.category tr.cat td { font-weight: 600; }
tbody.category tr.att td { color: var(--ink-2); }
tbody.category tr.att td:first-child { padding-left: 1.1rem; }
tbody.category tr:last-child td, tbody.category tr:last-child th { border-bottom-color: var(--rule-strong); }

/* Verdict mark: symbol + word, color as a third cue only. */
.verdict { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; white-space: nowrap; }
.verdict::before { content: ""; width: 0.7rem; height: 0.7rem; border-radius: 2px; background: var(--c); flex: none; }
.v-pass { --c: var(--pass); } .v-partial { --c: var(--partial); } .v-review { --c: var(--review); }
.v-fail { --c: var(--fail); } .v-invalid, .v-error { --c: var(--other); }

/* Findings */
.findings { list-style: none; padding: 0; margin: 1.25rem 0 0; }
.finding { border-top: 1px solid var(--rule-strong); padding: 1.25rem 0 1.5rem; }
.finding h3 { margin-top: 0.4rem; }
.finding .meta { color: var(--ink-2); font-size: 0.875rem; margin: 0.35rem 0 0; }
.finding .why { margin: 0.75rem 0 0; }
.finding h4 { font-size: 0.9375rem; font-weight: 600; margin: 1rem 0 0.4rem; }
.calls { margin: 0; padding-left: 1.4rem; }
.calls li { margin: 0 0 0.6rem; max-width: none; }
.calls .tool { font-weight: 600; }
.calls .err { color: var(--fail); font-size: 0.875rem; }
.calls .none { color: var(--muted); }
pre {
  margin: 0.3rem 0 0; padding: 0.6rem 0.75rem; background: var(--code-bg); border-radius: 4px;
  white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.45; max-height: 22rem; overflow: auto;
}
details { margin-top: 0.85rem; }
summary { cursor: pointer; color: var(--ink-2); }
summary:focus-visible, a:focus-visible { outline: 2px solid var(--asr-5); outline-offset: 2px; border-radius: 2px; }
.empty { color: var(--ink-2); }

footer { margin-top: 3.5rem; padding-top: 1rem; border-top: 1px solid var(--rule); color: var(--muted); font-size: 0.875rem; }
footer p { margin: 0 0 0.4rem; }

@media (max-width: 40rem) {
  body { padding: 0; }
  .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .facts div:nth-child(n+3) { border-top: 1px solid var(--rule); }
  .sheet { border: 0; border-radius: 0; padding-top: 2rem; }
}
@page { margin: 14mm 12mm; }
@media print {
  /* Paper is always light, whatever the viewer's theme. */
  :root, :root:not([data-theme="light"]), :root[data-theme="dark"] {
    color-scheme: light;
    --page: #ffffff; --sheet: #ffffff; --ink: #18202e; --ink-2: #4a5568; --muted: #646d7a;
    --rule: #d5dbe3; --rule-strong: #a9b3c1; --code-bg: #f1f4f8;
    --asr-1: #b7d3f6; --asr-2: #86b6ef; --asr-3: #5598e7;
    --asr-4: #3987e5; --asr-5: #2a78d6; --asr-6: #1c5cab; --asr-7: #104281; --asr-8: #0d366b;
    --asr-ink-low: #18202e; --asr-ink-high: #ffffff;
  }
  html, body { background: #fff; padding: 0; }
  body { font-size: 10pt; }
  .sheet { border: 0; padding: 0; max-width: none; background: #fff; }
  /* Every table fits the page: no scroll boxes, headers and cells wrap. */
  .scroll { overflow: visible; }
  table { width: 100%; font-size: 8.5pt; }
  th, td { padding: 0.3rem 0.3rem; white-space: normal; overflow-wrap: break-word; }
  thead th { white-space: normal; font-size: 8pt; hyphens: manual; }
  .asr { min-width: 0; }
  .low { white-space: normal; }
  .callout td.policy { max-width: none; }
  tr, .callout, .finding header { break-inside: avoid; }
  h2, h3 { break-after: avoid; }
  details { display: block; }
  pre { max-height: none; overflow: visible; font-size: 8pt; }
  .asr, .verdict::before, mark.diff, .ramp span { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
@media (forced-colors: active) {
  .verdict::before { forced-color-adjust: none; border: 1px solid CanvasText; }
  .asr { border: 1px solid CanvasText; }
}
</style>
</head>
<body>
{% macro rate(value, tally) %}{{ value|pct }}{% if tally.low_sample and value is not none %}<span class="low">low sample</span>{% endif %}{% endmacro %}
{% macro exposure_cell(tally) %}{% if report.exposure_checked %}{{ tally.exposed }} of {{ tally.runs }}{% else %}n/a{% endif %}{% endmacro %}
{% macro comparison_block() %}
{% for c in report.comparisons %}
<aside class="callout" aria-label="Policy comparison for {{ c.attack_id }}">
  <h3>Policy comparison: <span class="mono">{{ c.attack_id }}</span></h3>
  <p>{{ comparison_lines[loop.index0] }}</p>
  <div class="scroll">
  <table class="compare">
    <thead><tr>
      <th scope="col">Version</th><th scope="col" style="text-align:left">Policy (system prompt)</th>
      <th scope="col">Influenced rate</th><th scope="col">Attack success rate</th>
      <th scope="col">Exposure</th>
    </tr></thead>
    {% set segments = policy_segments(c.versions) %}
    {% for v in c.versions %}
    <tbody class="version">
    <tr>
      <th scope="row" class="mono" style="font-weight:400">v{{ v.version }}</th>
      <td class="policy">{% if v.policy %}{% for text, shared in segments[loop.index0] %}{% if shared %}<span class="shared">{{ text }}</span>{% else %}<mark class="diff">{{ text }}</mark>{% endif %}{% if not loop.last %} {% endif %}{% endfor %}{% else %}Not recorded{% endif %}</td>
      <td>{{ rate(v.tally.influenced_rate, v.tally) }}</td>
      <td>{{ rate(v.tally.asr, v.tally) }}</td>
      <td>{{ exposure_cell(v.tally) }}</td>
    </tr>
    <tr class="did-row"><td colspan="5" class="did"><strong>What the model did ({{ v.label }}):</strong> {{ what_it_did(v) }}</td></tr>
    </tbody>
    {% endfor %}
  </table>
  <p class="note">Highlighted: the sentences that differ between versions. Muted: text every version shares.</p>
  </div>
</aside>
{% endfor %}
{% endmacro %}
<main class="sheet">

<header>
  <p class="kicker">Lure agent security report</p>
  <h1>{{ headline }}</h1>
  <dl class="facts">
    <div><dt>Target</dt><dd>{{ model }}<small>{{ report.target }}</small></dd></div>
    <div><dt>Judge</dt><dd>
      {% if report.judges|length == 1 %}{{ judge_names[0][0] }}{% else %}Mixed<small>{% for name, n in judge_names %}{{ name }} ({{ n }}){% if not loop.last %}, {% endif %}{% endfor %}</small>{% endif %}
    </dd></div>
    <div><dt>Date</dt><dd>{{ dates }}</dd></div>
    <div><dt>Runs</dt><dd>{{ report.total.runs }}<small>{{ report.total.scored }} scored, {{ report.attacks|length }} attacks</small></dd></div>
    <div><dt>Pass rate</dt><dd>{{ report.total.pass_rate|pct }}<small>{{ report.total.counts[Verdict.PASS] }} of {{ report.total.scored }}{% if report.total.low_sample %}, low sample{% endif %}</small></dd></div>
    <div><dt>Influenced rate</dt><dd>{{ report.total.influenced_rate|pct }}<small>{{ report.total.influenced }} of {{ report.total.scored }}{% if report.total.low_sample %}, low sample{% endif %}</small></dd></div>
    <div><dt>Attack success rate</dt><dd>{{ report.total.asr|pct }}<small>{{ report.total.counts[Verdict.FAIL] }} runs broke the rules</small></dd></div>
    <div><dt>Exposure</dt><dd>{% if report.exposure_checked %}{{ report.total.exposed }} runs<small>{{ report.total.exposure_calls }} calls outside allowed domains</small>{% else %}Not checked<small>no org policy</small>{% endif %}</dd></div>
  </dl>
</header>

<section aria-labelledby="summary">
  <h2 id="summary">Summary</h2>
  <ul class="summary">
    {% for bullet in summary %}
    <li>{{ bullet }}</li>
    {% endfor %}
  </ul>
  {{ comparison_block() }}
  <p class="note">Influenced rate: Partial and Review runs over scored runs, where the attack swayed the agent without a rule-breaking action. Rates over fewer than 10 scored runs are marked low sample.</p>
</section>

<section aria-labelledby="techniques">
  <h2 id="techniques">Results by ATLAS technique</h2>
  <p class="lede">Each run counts once under every technique its attack maps to, so a row's runs can overlap with other rows. Darker means a higher influenced rate.</p>
  <div class="scroll">
  <table>
    <caption>Verdicts per MITRE ATLAS technique, highest attack success rate first, then highest influenced rate.</caption>
    <thead><tr>
      <th scope="col">Technique</th>
      <th scope="col">Attacks</th>
      {% for v in verdicts %}<th scope="col">{{ v.value }}</th>{% endfor %}
      <th scope="col">Influenced rate</th>
      <th scope="col">Attack success rate</th>
      <th scope="col">Exposure</th>
    </tr></thead>
    <tbody>
    {% for t in report.techniques %}
    <tr>
      <th scope="row" style="font-weight:400">{{ t.name }}<span class="tech-id">{{ t.technique }}</span></th>
      <td>{{ t.attacks|length }}</td>
      {% for v in verdicts %}{% set n = t.tally.counts[v] %}<td{% if not n %} class="zero"{% endif %}>{{ n }}</td>{% endfor %}
      <td class="asr {{ t.tally.influenced_rate|asr_step }}" title="{{ t.technique }}: influenced in {{ t.tally.influenced }} of {{ t.tally.scored }} scored runs">{{ rate(t.tally.influenced_rate, t.tally) }}</td>
      <td title="{{ t.technique }}: {{ t.tally.counts[Verdict.FAIL] }} of {{ t.tally.scored }} scored runs broke the rules">{{ rate(t.tally.asr, t.tally) }}</td>
      <td{% if not t.tally.exposed %} class="zero"{% endif %}>{{ exposure_cell(t.tally) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="legend" aria-hidden="true">
    <span>Influenced rate. Unfilled: no run influenced.</span>
    <span>Above 0%</span>
    <span class="ramp">{% for i in range(1, 9) %}<span style="background:var(--asr-{{ i }})"></span>{% endfor %}</span>
    <span>100% of scored runs</span>
  </div>
</section>

<section aria-labelledby="categories">
  <h2 id="categories">Results by category</h2>
  <p class="lede">Each attack version is its own row: a stricter v2 is a different test, so its runs never mix with v1.</p>
  <div class="scroll">
  <table>
    <caption>Pass, influenced, attack success and detection rates per category and attack. Rates leave out Invalid and Error runs.</caption>
    <thead><tr>
      <th scope="col">Category and attack</th>
      <th scope="col">Runs</th>
      <th scope="col">Pass rate</th>
      <th scope="col">Influenced rate</th>
      <th scope="col">Attack success rate</th>
      <th scope="col">Detection rate</th>
      <th scope="col">Exposure</th>
    </tr></thead>
    {% for c in report.categories %}
    <tbody class="category">
      <tr class="cat">
        <th scope="rowgroup">{{ c.name }} <span class="tech-id" style="display:inline">{{ c.attacks|length }} attacks</span></th>
        <td>{{ c.tally.runs }}</td><td>{{ rate(c.tally.pass_rate, c.tally) }}</td><td>{{ rate(c.tally.influenced_rate, c.tally) }}</td><td>{{ rate(c.tally.asr, c.tally) }}</td><td>{{ rate(c.tally.detection_rate, c.tally) }}</td><td{% if not c.tally.exposed %} class="zero"{% endif %}>{{ exposure_cell(c.tally) }}</td>
      </tr>
      {% for a in c.attacks %}
      <tr class="att">
        <td><span class="mono">{{ a.label }}</span><span class="tech-id">{{ a.name }}</span></td>
        <td>{{ a.tally.runs }}</td><td>{{ rate(a.tally.pass_rate, a.tally) }}</td><td>{{ rate(a.tally.influenced_rate, a.tally) }}</td><td>{{ rate(a.tally.asr, a.tally) }}</td><td>{{ rate(a.tally.detection_rate, a.tally) }}</td><td{% if not a.tally.exposed %} class="zero"{% endif %}>{{ exposure_cell(a.tally) }}</td>
      </tr>
      {% endfor %}
    </tbody>
    {% endfor %}
  </table>
  </div>
</section>

{% if report.exposure_checked %}
<section aria-labelledby="exposure">
  <h2 id="exposure">Exposure</h2>
  <p class="lede">Calls to a domain outside the org's allowed list ({{ policy_files|join(", ") }}), whatever the attack's own rules say. Exposure never changes a verdict.</p>
  {% if not report.exposed_runs %}
  <p class="empty">No run sent email or made a request outside the allowed domains.</p>
  {% else %}
  <ol class="findings">
    {% for r in report.exposed_runs %}
    <li class="finding">
      <header>
        <span class="verdict v-{{ r.verdict.value|lower }}"><span aria-hidden="true">{{ marks[r.verdict] }}</span>{{ r.verdict.value }}</span>
        <h3><span class="mono">{{ r.label }}</span> {{ r.attack.name }}</h3>
      </header>
      <p class="meta">Run {{ r.started_at.strftime("%Y-%m-%d %H:%M UTC") }}.</p>
      <ol class="calls">
        {% for c in r.exposure_calls %}
        <li><span class="tool mono">{{ c.tool }}</span> to {{ c.outside|join(", ") }}{% if c.failed %} <span class="err">failed</span>{% endif %}
          <pre>{{ c.args|pretty_args }}</pre></li>
        {% endfor %}
      </ol>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</section>
{% endif %}

<section aria-labelledby="findings">
  <h2 id="findings">Findings</h2>
  <p class="lede">Every Fail, Partial and Review run: Fail first, then Partials the judge confirmed, then Review, then Partials from the rules alone. Tool calls are exactly as the agent made them; nothing in them reached a real system.</p>
  {{ comparison_block() }}
  {% if not report.findings %}
  <p class="empty">No Fail, Partial or Review runs.</p>
  {% else %}
  <ol class="findings">
    {% for f in report.findings %}
    {% set j = f.record.judgment %}
    <li class="finding">
      <header>
        <span class="verdict v-{{ f.verdict.value|lower }}"><span aria-hidden="true">{{ marks[f.verdict] }}</span>{{ f.verdict.value }}</span>
        <h3><span class="mono">{{ f.label }}</span> {{ f.attack.name }}</h3>
      </header>
      <p class="meta">{{ f.attack.category|category_name }}, {{ f.attack.severity }} severity. Run {{ f.started_at.strftime("%Y-%m-%d %H:%M UTC") }}, judged by {{ judge_name(f.judge) }}.
        ATLAS {{ f.attack.atlas|join(", ") }}{% if f.attack.attack %}; ATT&amp;CK {{ f.attack.attack|join(", ") }}{% endif %}.</p>
      <p class="why">{{ why(f) }}</p>
      {% if f.rank == 3 %}<p class="note">Rules only: the asking check matched; the judge did not confirm it.</p>{% elif f.rank == 9 %}<p class="note">The judge called this reply detected.</p>{% endif %}
      <h4>Tool calls</h4>
      {% if f.record.tool_calls %}
      <ol class="calls">
        {% for c in f.record.tool_calls %}
        <li><span class="tool mono">{{ c.tool }}</span>{% if c.result is mapping and c.result.error is defined %} <span class="err">failed: {{ c.result.error }}</span>{% endif %}
          <pre>{{ c.args|pretty_args }}</pre></li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="none">No tool calls.</p>
      {% endif %}
      {% if f.record.final_text %}
      <details>
        <summary>Agent's final reply</summary>
        <pre>{{ f.record.final_text }}</pre>
      </details>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</section>

<footer>
  <p>Built by <code>lure report</code> from {{ report.runs|length }} saved runs on {{ generated }}. Scored from the tool-call log; the judge model only classifies the agent's final reply.</p>
  <p>Invalid runs (the target never saw the attack or never did the task) and Error runs are counted but left out of every rate.</p>
</footer>

</main>
</body>
</html>
