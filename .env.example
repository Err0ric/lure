# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# Used by the optional live smoke test (pytest -m ollama).
LURE_OLLAMA_URL=http://localhost:11434
LURE_OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible target (--target openai): OpenAI, vLLM, Groq, LM Studio,
# llama.cpp and other servers with a /chat/completions endpoint. The key is
# optional for servers that need none (most local ones).
LURE_OPENAI_BASE_URL=https://api.openai.com/v1
LURE_OPENAI_API_KEY=
LURE_OPENAI_MODEL=

# The model key for an agent in the sandbox (lure sandbox run). Use a
# separate key with a spend cap: the agent under test holds it and can use
# it for anything the key allows. Lure never passes ANTHROPIC_API_KEY into a
# sandbox, and refuses to start if only that one is set.
LURE_AGENT_API_KEY=
