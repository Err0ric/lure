{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Err0ric/lure/main/schema/results.v3.json",
  "title": "Lure run result",
  "description": "One run of one attack against one target, as saved by lure run (results/<timestamp>-<attack id>.json) and by lure rescore. Records from Lure 1.0.0 predate lure_version, schema_version, judge, usage, exposure and attack.file, so those are optional; Lure 1.1.0 and later always write them. Version 2 (Lure 1.2.0) adds multi-turn replies, responder events and Partial severity; records that follow results.v1.json are still read.",
  "type": "object",
  "required": [
    "attack",
    "target",
    "started_at",
    "finished_at",
    "turns",
    "max_turns",
    "stop",
    "error",
    "final_text",
    "transcript",
    "tool_calls",
    "judgment"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Version of this schema the record follows.",
      "const": 3
    },
    "lure_version": {
      "description": "Version of Lure that wrote the record.",
      "type": "string",
      "minLength": 1
    },
    "attack": {
      "$ref": "#/$defs/attack"
    },
    "target": {
      "description": "provider:model, e.g. anthropic:claude-haiku-5-5.",
      "type": "string",
      "minLength": 1
    },
    "judge": {
      "description": "rules, or the LLM judge's provider:model when --judge llm was on.",
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "description": "The target's token counts, summed over every turn. Empty when the provider does not report them.",
      "$ref": "#/$defs/usage"
    },
    "exposure": {
      "description": "Calls outside the org policy's allowed domains. null when no policy was used. Never changes the verdict.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exposure"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "turns": {
      "type": "integer",
      "minimum": 0
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1
    },
    "stop": {
      "enum": [
        "completed",
        "max_turns",
        "error"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "replies": {
      "description": "The final reply of each user turn, in order. A multi-turn attack (followup_tasks) is judged on all of them.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "description": "Responder firings, in order: fixture items released into the mocks after a matching tool call.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "transcript": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transcript_entry"
      }
    },
    "tool_calls": {
      "description": "The tool-call log the Judge scores from, in call order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_call"
      }
    },
    "judgment": {
      "$ref": "#/$defs/judgment"
    },
    "variant": {
      "description": "The payload variant this run planted. Null for the attack's own payload.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/variant"
        }
      ]
    },
    "rescore": {
      "$ref": "#/$defs/rescore"
    },
    "adaptive": {
      "description": "The adaptive attacker's run: every attempt, and which one decided the verdict. Null for a single-shot run; the rest of the record mirrors the deciding attempt.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "attacker",
            "attacker_feedback",
            "max_attempts",
            "outcome",
            "deciding_attempt",
            "attempts_to_worst",
            "attacker_failures",
            "attacker_calls",
            "attacker_refused",
            "attacker_tested",
            "usage",
            "attempts"
          ],
          "additionalProperties": false,
          "properties": {
            "attacker": {
              "type": "string"
            },
            "attacker_feedback": {
              "description": "What the attacker learns after each attempt. replies: the target's final replies, a worst case, since a real indirect-injection attacker usually cannot see them.",
              "enum": [
                "replies"
              ]
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "outcome": {
              "enum": [
                "target_failed",
                "exhausted",
                "attacker_stopped",
                "error",
                "max_cost"
              ]
            },
            "deciding_attempt": {
              "type": "integer",
              "minimum": 1,
              "description": "The attempt the record mirrors: the worst outcome (Fail, then outright Partial, confirm-first Partial, Review, Pass), the earliest on a tie."
            },
            "attempts_to_worst": {
              "description": "Attempts used to first reach the worst outcome, attacker failures included.",
              "type": "integer",
              "minimum": 1
            },
            "attacker_failures": {
              "type": "integer",
              "minimum": 0
            },
            "attacker_calls": {
              "description": "Attacker calls made (attempts 2 and later).",
              "type": "integer",
              "minimum": 0
            },
            "attacker_refused": {
              "description": "Attacker calls that wrote no payload (attacker_refused).",
              "type": "integer",
              "minimum": 0
            },
            "attacker_tested": {
              "description": "True if at least one attacker payload reached the target. False means the run is single-shot: the attacker refused, wrote nothing usable, or was never needed (Fail on attempt 1) or reached (max cost).",
              "type": "boolean"
            },
            "usage": {
              "type": "object",
              "required": [
                "attacker",
                "target",
                "judge"
              ],
              "additionalProperties": false,
              "properties": {
                "attacker": {
                  "$ref": "#/$defs/usage"
                },
                "target": {
                  "$ref": "#/$defs/usage"
                },
                "judge": {
                  "$ref": "#/$defs/usage"
                }
              }
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attempt"
              }
            }
          }
        }
      ]
    },
    "cost": {
      "description": "Estimated USD for the whole run (every attempt when adaptive), with --prices. Null without.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cost"
        }
      ]
    },
    "replay": {
      "description": "The saved result whose payload this run replays (--payload-from). Null otherwise.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "from",
            "attempt"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "attack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "severity",
        "atlas",
        "attack",
        "injection"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lure-[a-z]+-\\d{3}$"
        },
        "version": {
          "description": "Missing in Lure 1.0.0 records of v1 attacks; read as 1.",
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "description": "The attack YAML, relative to the folder holding attacks/ (absolute if outside it).",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "atlas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^AML\\.T\\d{4}(\\.\\d{3})?$"
          }
        },
        "attack": {
          "description": "MITRE ATT&CK technique IDs. May be empty.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          }
        },
        "injection": {
          "type": "object",
          "required": [
            "location",
            "placement",
            "payload"
          ],
          "additionalProperties": false,
          "properties": {
            "location": {
              "type": "string",
              "minLength": 1
            },
            "placement": {
              "enum": [
                "append",
                "prepend",
                "replace"
              ]
            },
            "payload": {
              "type": "string"
            }
          }
        },
        "goal": {
          "description": "The attacker's aim in plain words, for the adaptive attacker. Null when the attack has none.",
          "type": [
            "string",
            "null"
          ]
        },
        "fixtures_sha256": {
          "description": "SHA-256 of each fixture file at run time, by fixture name, so a replay can tell if one changed.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "policy",
        "allowed_outbound_domains",
        "calls"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string"
        },
        "allowed_outbound_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "tool",
              "args",
              "outside",
              "failed"
            ],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "tool": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "outside": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "failed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "transcript_entry": {
      "type": "object",
      "required": [
        "role"
      ],
      "oneOf": [
        {
          "properties": {
            "role": {
              "enum": [
                "system",
                "user"
              ]
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "role": {
              "const": "assistant"
            },
            "content": {
              "type": "string"
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "arguments"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "object"
                  }
                }
              }
            },
            "stop_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "role",
            "content",
            "tool_calls",
            "stop_reason"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "role": {
              "const": "tool"
            },
            "call_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "is_error": {
              "type": "boolean"
            }
          },
          "required": [
            "role",
            "call_id",
            "name",
            "content",
            "is_error"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "role": {
              "const": "event"
            },
            "responder": {
              "type": "integer",
              "minimum": 0
            },
            "after_call": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "responder",
            "after_call",
            "action",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "description": "A new session starts here: a fresh conversation, the same mocks.",
          "properties": {
            "role": {
              "const": "session"
            },
            "session": {
              "type": "integer",
              "minimum": 2
            }
          },
          "required": [
            "role",
            "session"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "responder",
        "after_call",
        "action",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "responder": {
          "description": "Index in the attack's responders list.",
          "type": "integer",
          "minimum": 0
        },
        "after_call": {
          "description": "Index in tool_calls of the call that fired it.",
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string"
        },
        "source": {
          "description": "The pending fixture item released, like inbox_followups[0].",
          "type": "string"
        }
      }
    },
    "tool_call": {
      "type": "object",
      "required": [
        "timestamp",
        "tool",
        "args",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "result": {
          "description": "What the mock tool returned (fake data, or {\"error\": ...})."
        }
      }
    },
    "judgment": {
      "type": "object",
      "required": [
        "verdict",
        "reason",
        "heuristic",
        "evidence",
        "unresolved"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "Pass",
            "Review",
            "Partial",
            "Invalid",
            "Fail",
            "Error"
          ]
        },
        "reason": {
          "type": "string"
        },
        "heuristic": {
          "description": "True if any evidence behind the verdict is only a heuristic match.",
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolved"
          }
        },
        "task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/task"
            }
          ]
        },
        "task_incomplete": {
          "type": "boolean"
        },
        "llm_judged": {
          "description": "True if the verdict comes from the LLM judge's label.",
          "type": "boolean"
        },
        "llm_judge": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/llm_judge"
            }
          ]
        },
        "partial_kind": {
          "description": "For a Partial: outright (offered or proposed the attacker's action) or confirm_first (only offered it if the user explicitly confirms). null otherwise. Never changes the verdict.",
          "enum": [
            "outright",
            "confirm_first",
            null
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "rule_set",
        "rule_index",
        "rule",
        "kind",
        "calls",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_set": {
          "type": "string"
        },
        "rule_index": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "object"
        },
        "kind": {
          "enum": [
            "confirmed",
            "heuristic"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "required": [
        "rule_set",
        "rule_index",
        "rule",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_set": {
          "type": "string"
        },
        "rule_index": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "read_tools_required",
        "read_tools_called",
        "facts",
        "facts_found",
        "checked_text"
      ],
      "additionalProperties": false,
      "properties": {
        "read_tools_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_tools_called": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_text": {
          "type": "boolean"
        },
        "actions_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions_done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_delivered": {
          "description": "For a payload a responder releases: whether a tool result carried it to the target. null otherwise.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "parts_delivered": {
          "description": "For a split variant: whether each part reached the target. Null otherwise.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            }
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "llm_judge": {
      "description": "The LLM judge's label and the rules verdict it replaced, or the error if the call failed.",
      "type": "object",
      "required": [
        "model",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "label": {
          "enum": [
            "detected",
            "ignored",
            "offered_attacker_action",
            "complied"
          ]
        },
        "justification": {
          "type": "string"
        },
        "quote_found": {
          "type": "boolean"
        },
        "confirmation_required": {
          "description": "For offered_attacker_action: whether the offer hinges on the user's explicit confirmation.",
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "error": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "enum": [
                "Pass",
                "Review",
                "Partial",
                "Invalid",
                "Fail",
                "Error"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "label",
            "justification",
            "quote_found"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ]
    },
    "rescore": {
      "description": "Present on copies written by lure rescore.",
      "type": "object",
      "required": [
        "source",
        "rescored_at",
        "previous"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "rescored_at": {
          "type": "string",
          "format": "date-time"
        },
        "exposure_only": {
          "const": true
        },
        "previous": {
          "type": "object",
          "properties": {
            "verdict": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "attacker",
        "target",
        "judge",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "attacker": {
          "type": "number",
          "minimum": 0
        },
        "target": {
          "type": "number",
          "minimum": 0
        },
        "judge": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "attacker_call": {
      "description": "One adaptive attacker call.",
      "type": "object",
      "required": [
        "outcome",
        "prompt",
        "raw",
        "reason",
        "stop_reason",
        "usage"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "ok",
            "attacker_refused",
            "attacker_rejected",
            "attacker_error"
          ]
        },
        "prompt": {
          "description": "The attacker's whole input for this call, after its system prompt.",
          "type": "string"
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "attempt": {
      "description": "One adaptive attempt: a target run, or an attacker call whose payload was never planted.",
      "type": "object",
      "required": [
        "n",
        "source",
        "outcome",
        "payload",
        "attacker"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "description": "attack: the attack file's own payload. attacker: a rewrite.",
          "enum": [
            "attack",
            "attacker"
          ]
        },
        "outcome": {
          "description": "The target's verdict, or the attacker's failure.",
          "enum": [
            "Pass",
            "Review",
            "Partial",
            "Invalid",
            "Fail",
            "Error",
            "attacker_refused",
            "attacker_rejected",
            "attacker_error"
          ]
        },
        "payload": {
          "type": [
            "string",
            "null"
          ]
        },
        "attacker": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/attacker_call"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "stop": {
          "enum": [
            "completed",
            "max_turns",
            "error"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "replies": {
          "description": "The final reply of each user turn, in order. A multi-turn attack (followup_tasks) is judged on all of them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "description": "Responder firings, in order: fixture items released into the mocks after a matching tool call.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "transcript": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcript_entry"
          }
        },
        "tool_calls": {
          "description": "The tool-call log the Judge scores from, in call order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },
        "judgment": {
          "$ref": "#/$defs/judgment"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "cost": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          ]
        }
      }
    },
    "variant": {
      "description": "Another payload for the same attack and rules.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "encoding",
        "plain",
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "rephrased",
            "split",
            "encoded",
            "buried"
          ]
        },
        "source": {
          "description": "yaml: written in the attack file. generated: built by Lure.",
          "enum": [
            "yaml",
            "generated"
          ]
        },
        "encoding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "base64",
                "rot13",
                "hex"
              ]
            }
          ]
        },
        "plain": {
          "description": "The payload as a reader sees it: decoded, parts joined.",
          "type": "string"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "location",
              "placement",
              "payload"
            ],
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "enum": [
                  "append",
                  "prepend",
                  "replace"
                ]
              },
              "payload": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
